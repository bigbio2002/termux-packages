--- a/usr/include/limits.h
+++ b/usr/include/limits.h
@@ -59,6 +59,39 @@
 
 __BEGIN_DECLS
 
+#ifndef CHAR_BIT
+#define CHAR_BIT 8
+#endif
+
+#ifndef TYPE_SIGNED
+#define TYPE_SIGNED(t)	(! ((t) 0 < (t) -1))
+#endif
+
+#ifndef TYPE_WIDTH
+#define TYPE_WIDTH(t)	(sizeof (t) * CHAR_BIT)
+#endif
+
+#ifndef TYPE_MAXIMUM
+#define TYPE_MAXIMUM(t) \
+	((t) (! TYPE_SIGNED (t) \
+		? (t) -1 \
+		: ((((t) 1 << (TYPE_WIDTH (t) - 2)) - 1) * 2 + 1)))
+#endif
+
+#ifndef TYPE_MINIMUM
+#define TYPE_MINIMUM(t)	((t) ~ TYPE_MAXIMUM (t))
+#endif
+
+#ifndef UTYPE_MAXIMUM
+#define UTYPE_MAXIMUM(t)	((t) ~(t) 0)
+#endif
+
+#ifndef INT_MAX
+#define INT_MAX TYPE_MAXIMUM(int)
+#define INT_MIN TYPE_MINIMUM(int)
+#define UINT_MAX UTYPE_MAXIMUM(unsigned int)
+#endif
+
 /** Maximum buffer size for getentropy(). */
 #define GETENTROPY_MAX 256
 
